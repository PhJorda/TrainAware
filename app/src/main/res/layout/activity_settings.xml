<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#373737"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Bar with Back Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#B4B4B4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/settings_title"
            android:textColor="#B4B4B4"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbHeartbeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/setting_heartbeat"
        android:textColor="#B4B4B4"
        android:textSize="18sp" />

    <CheckBox
        android:id="@+id/cbTrainNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/setting_train_number"
        android:textColor="#B4B4B4"
        android:textSize="18sp" />

    <CheckBox
        android:id="@+id/cbDeveloperMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/developer_mode"
        android:textColor="#B4B4B4"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvDeveloperModeInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="24dp"
        android:text="@string/developer_mode_info"
        android:textColor="#B4B4B4"
        android:textSize="14sp" />

</LinearLayout>
